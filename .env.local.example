# Required. From https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required in production, optional locally. From https://console.upstash.com (Redis → REST API).
# Without these the app keeps all state in memory and loses it on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to the deployed address so shared links preview correctly. Vercel fills this in from
# VERCEL_URL if you leave it unset, which is right for previews but not for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional. Defaults shown. Raise these to spend more.
PER_IP_DAILY_LIMIT=3
GLOBAL_DAILY_LIMIT=12
MONTHLY_CHECK_BUDGET=140

# Optional. claude-sonnet-5 costs about a fifth as much, with vaguer summaries.
# BIAS_CHECK_MODEL=claude-sonnet-5
